.page {
  padding: 16rpx;
  font-size: 26rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.env {
  color: #888;
  font-size: 22rpx;
  word-break: break-all;
  margin-bottom: 12rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.row,
.metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}
.label {
  color: #555;
}
.value {
  font-family: monospace;
  text-align: right;
}
.value.ok {
  color: #1a8a3c;
}
.value.bad {
  color: #d4380d;
}
.input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  margin-bottom: 8rpx;
}
.pick {
  color: #1677ff;
}
.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.error {
  color: #d4380d;
  margin-top: 8rpx;
}
.events {
  height: 360rpx;
}
.event {
  font-family: monospace;
  font-size: 22rpx;
  color: #333;
  padding: 2rpx 0;
}
