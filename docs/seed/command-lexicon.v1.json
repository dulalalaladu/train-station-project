    { "code": "ANNOUNCE_BELONGINGS", "category": "announce", "min_role": "guard", "priority": 8, "canonical_zh": "保管物品提示", "aliases": [], "english": ["belongings notice"], "action": "announce", "announcement_code": "belongings", "reply_zh": "请保管好随身物品，防止遗失", "reply_en": "Please keep your belongings safe", "slots": {} }
