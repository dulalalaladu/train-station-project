    { "code": "ANNOUNCE_CROWD", "category": "announce", "min_role": "guard", "priority": 6, "canonical_zh": "客流疏导", "aliases": [], "english": ["crowd guidance"], "action": "announce", "announcement_code": "crowd_guidance", "reply_zh": "前方列车即将进站，请退到安全线内等候", "reply_en": "Train arriving, please stay behind the safety line", "slots": {} },
