{
  "name": "railvoice",
  "version": "0.0.0",
  "private": true,
  "description": "RailVoice monorepo root (铁路站场人机语音互动系统)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint scripts eslint.config.mjs commitlint.config.mjs lint-staged.config.mjs vitest.shared.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "py:sync": "node scripts/run-py.mjs sync",
    "postinstall": "node scripts/run-py.mjs sync --soft",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "catalog:"
  }
}
